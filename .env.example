# Copy to .env for local runs. In GitHub Actions these come from repo secrets.

# --- Email (SMTP) ---
# Gmail example: create an App Password (requires 2-Step Verification) and use it here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@example.com
SMTP_PASS=your-gmail-app-password
ALERT_TO=you@example.com
# Optional: override the From header (defaults to SMTP_USER)
ALERT_FROM=

# --- Identity ---
# Shown in the digest subject line and headings.
ORG_NAME=Your Company
# Sent in the User-Agent to every agency endpoint. Use a real inbox.
CONTACT_EMAIL=you@example.com

# --- Behavior ---
# Set to 1 to render the digest to stdout instead of sending email.
DRY_RUN=
# Forward window (months) for the expiring-contract predictor (Stream B).
POP_WINDOW_MONTHS=18
# Ignore expiring contracts below this award amount in the predictor (Stream B).
PREDICT_MIN_USD=250000
# Include 'adjacent' fit opportunities in alerts, not just 'direct-fit' (1/0).
INCLUDE_ADJACENT=1
# Governmentwide forecast source (GSA Acquisition Gateway, all non-Treasury agencies); 0 to disable.
ENABLE_GATEWAY=1
